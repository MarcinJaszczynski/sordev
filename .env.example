APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DEBUGBAR_ENABLED=false
APP_URL=http://127.0.0.1:8000
APP_PUBLIC_URL=http://127.0.0.1:8000
# Bazowy host w /llms.txt (katalog AI) — produkcja:
APP_LLMS_URL=https://bprafa.pl
APP_TIMEZONE=Europe/Warsaw

# Porównywanie cen szablonów między środowiskami (panel admin + eventtemplate:compare-prices)
PRICE_COMPARE_TOKEN=
PRICE_COMPARE_PROD_URL=https://bprafa.pl
PRICE_COMPARE_DEV_URL=https://sor41.webgarage.pl
PRICE_COMPARE_LOCAL_URL=http://127.0.0.1:8000
PRICE_COMPARE_THRESHOLD=1

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Baza dev: MySQL host378742_sor26 @ 127.0.0.1:3306 (natywny MySQL na hoście)
# Pierwsza konfiguracja: make setup  (szczegóły: docs/DEV.md)
# Po git pull: php artisan app:migrate-check
# Moduł UFG: php artisan ufg:install
# NIE uruchamiaj php artisan migrate na pustej bazie bez importu dumpu (make setup)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=host378742_sor26
DB_USERNAME=sor
DB_PASSWORD=sor_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Na produkcji za HTTPS ustaw true (wymaga trustProxies w bootstrap/app.php)
SESSION_SECURE_COOKIE=
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Biuro / właściciel (wnioski, zapytania WWW). Produkcja: rafa@bprafa.pl
MAIL_INQUIRIES_TO=rafa@bprafa.pl

# Fallback trybu demo poczty (gdy w panelu System → Tryb demo jeszcze nic nie zapisano).
# Preferowane: włącz/wyłącz i ustaw e-mail w UI — wtedy wpis w DB ma pierwszeństwo.
# MAIL_DEMO_TO=m.jaszczynski@gmail.com

COMPANY_NAME="Biuro Podróży RAFA"
COMPANY_ADDRESS_LINE_1="ul. Przykładowa 1"
COMPANY_ADDRESS_LINE_2="00-000 Warszawa, Polska"
COMPANY_PHONE="+48 000 000 000"
COMPANY_EMAIL="kontakt@example.com"
COMPANY_WEBSITE="https://example.com"
COMPANY_LOGO_PATH="uploads/logo.png"
COMPANY_NIP="${INVOICES_AGENCY_NIP}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Audyt konsoli (make console-audit) — domyślne konta z app:console-audit-bootstrap
CONSOLE_AUDIT_ADMIN_EMAIL=console-audit@local
CONSOLE_AUDIT_ADMIN_PASSWORD=console-audit
CONSOLE_AUDIT_PILOT_EMAIL=pilot@test.local
CONSOLE_AUDIT_PILOT_PASSWORD=pilot123

INVOICES_AGENCY_NIP=7162508761
INVOICES_STORAGE_DISK=public
INVOICES_KSEF_OUTBOUND_ENABLED=false

# Fakturownia.pl (opcjonalnie — wystawianie FV VAT-marża przy realizacji wniosku)
# FAKTUROWNIA_DOMAIN=twoja-firma
# FAKTUROWNIA_API_TOKEN=
# FAKTUROWNIA_SELLER_TAX_NO=

# OpenRouteService — odległości drogowe między miejscami (Directions driving-car)
# Klucz można też podać w panelu: System → OpenRouteService (ma pierwszeństwo przed .env).
# OPENROUTESERVICE_API_KEY=
# OPENROUTESERVICE_REQUESTS_PER_MINUTE=35
# OPENROUTESERVICE_DAILY_LIMIT=2000
# OPENROUTESERVICE_MIN_INTERVAL_MS=1700

# Cloudflare Turnstile (formularz wniosku o fakturę / ochrona WWW)
# CF_TURNSTILE_SITE_KEY=
# CF_TURNSTILE_SECRET_KEY=

# Płatności online (fake | tpay | payu) — fake = lokalny checkout bez PSP
PAYMENTS_DRIVER=fake
PAYMENTS_CURRENCY=PLN
PAYMENTS_SESSION_TTL_HOURS=24
PAYMENTS_REMINDER_CADENCE_DAYS=3,7,14
PAYMENTS_REMINDER_SCHEDULE_AT=09:00
