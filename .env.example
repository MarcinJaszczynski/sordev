APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DEBUGBAR_ENABLED=false
APP_URL=http://127.0.0.1:8000
APP_PUBLIC_URL=http://127.0.0.1:8000
APP_TIMEZONE=Europe/Warsaw

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Baza dev: MySQL host378742_sor26 @ 127.0.0.1:3306 (natywny MySQL na hoście)
# Pierwsza konfiguracja: make setup  (szczegóły: docs/DEV.md)
# Po git pull: php artisan app:migrate-check
# Moduł UFG: php artisan ufg:install
# NIE uruchamiaj php artisan migrate na pustej bazie bez importu dumpu (make setup)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=host378742_sor26
DB_USERNAME=sor
DB_PASSWORD=sor_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

COMPANY_NAME="Biuro Podróży RAFA"
COMPANY_ADDRESS_LINE_1="ul. Przykładowa 1"
COMPANY_ADDRESS_LINE_2="00-000 Warszawa, Polska"
COMPANY_PHONE="+48 000 000 000"
COMPANY_EMAIL="kontakt@example.com"
COMPANY_WEBSITE="https://example.com"
COMPANY_LOGO_PATH="uploads/logo.png"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Audyt konsoli (make console-audit) — domyślne konta z app:console-audit-bootstrap
CONSOLE_AUDIT_ADMIN_EMAIL=console-audit@local
CONSOLE_AUDIT_ADMIN_PASSWORD=console-audit
