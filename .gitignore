### Laravel / common ignores

# Dependencies
/vendor/
/node_modules/

# Environment
/.env
/.env.*

# Build / runtime artifacts
/build/
/public/hot
/public/storage
/public/build
/public/vite-dist
/public/mix-manifest.json
/public/js/*.js.map
/public/css/*.css.map
/public/*.hot-update.*
/public/*.map
/public/*.log
/public/*.tmp
/public/*.cache
/public/*.pid
/public/*.seed
/public/*.sqlite
/public/*.bak

# Storage & cache
/storage/*.key
/storage/app/public
/storage/app/testing
/storage/debugbar
/storage/framework/cache/data
/storage/framework/sessions
/storage/framework/testing
/storage/framework/views
/storage/logs
/storage/console-audit
!/storage/framework/views/.gitignore

# IDE / editor
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
/.cursor/mcp.json

# OS / archive artifacts
.DS_Store
._*
__MACOSX/

# Temporary / backup files
*.bak
*.sqlite.bak
*.tmp
*.log
server.log
server.pid
Zrzut*png

# Project-specific temp or legacy
mergingSOR/
sorstary/
/pliki/
/.local/
/storage/backups/
*.sql
!database/migrations/*.sql
!scripts/**/*.sql
/deploy/*.sql
/deploy/build-*/

# Keep tracked local sqlite database if used in this repo
!database/database.sqlite