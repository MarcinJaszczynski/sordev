# SOR41 — konfiguracja deploymentu (skopiuj jako deploy/config/app.env na serwerze)
# cp deploy/config/app.env.example deploy/config/app.env

APP_BASE="/var/www/travel-office"
APP_ENV_NAME="production"
APP_URL="https://app.example.com"
DEPLOY_USER="deploy"

PHP_BIN="php"
PHP_FPM_SERVICE="php8.4-fpm"
COMPOSER_BIN="composer"

RELEASES_TO_KEEP=5
MIN_FREE_DISK_GB=2

HEALTH_CHECK_URL="${APP_URL}/up"
HEALTH_CHECK_TIMEOUT=30

SUPERVISOR_WORKER_GROUP="travel-office-worker:*"

# Powiadomienia monitoringu (pusty = wyłączone)
MONITOR_EMAIL="ops@example.com"

# Retencja backupów OS-level
BACKUP_KEEP_MYSQL=14
BACKUP_KEEP_STORAGE=7
BACKUP_KEEP_ENV=30
BACKUP_KEEP_CONFIG=7

# Staging — przykład osobnego pliku na VPS TEST:
# APP_BASE="/var/www/travel-office"
# APP_ENV_NAME="staging"
# APP_URL="https://staging.example.com"
